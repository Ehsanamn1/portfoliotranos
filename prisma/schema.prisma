generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model ContactMessage {
  id          String   @id @default(cuid())
  name        String
  email       String
  company     String?
  projectType String?
  message     String
  status      String   @default("NEW")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([createdAt])
  @@index([status, createdAt])
}

model Project {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String
  category    String
  year        Int
  featured    Boolean  @default(false)
  published   Boolean  @default(true)
  imageUrl    String?
  clientName  String?
  role        String?
  challenge   String?
  solution    String?
  impact      String?
  technologies String?
  galleryUrls String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([published, featured, sortOrder])
}

model Insight {
  id            String    @id @default(cuid())
  slug          String    @unique
  title         String
  excerpt       String
  content       String
  coverImageUrl String?
  published     Boolean   @default(false)
  publishedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([published, publishedAt])
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         String   @default("ADMIN")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions AdminSession[]
}

model AdminSession {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime  @default(now())

  user AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}


model Service {
  id          String   @id @default(cuid())
  slug        String   @unique
  number      String
  title       String
  description String
  capabilities String?
  sortOrder   Int      @default(0)
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([published, sortOrder])
}

model SiteSetting {
  id              String   @id
  brandName       String   @default("TRANOS")
  tagline         String   @default("Digital / AI / Creative")
  heroTitle       String   @default("Ideas into Digital Reality.")
  heroDescription String   @default("Tranos is an independent digital studio building premium experiences, intelligent systems and visual identities for ambitious teams.")
  email           String   @default("hello@tranos.studio")
  location        String   @default("Tehran · Remote Worldwide")
  footerNote      String   @default("Built for the next digital era.")
  linkedinUrl     String?
  instagramUrl    String?
  behanceUrl      String?
  dribbbleUrl     String?
  defaultLocale   String   @default("en")
  defaultTheme    String   @default("dark")
  updatedAt       DateTime @updatedAt
}
